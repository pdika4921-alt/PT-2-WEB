<%- include('partials/topnav') %>

<%
  function scriptJson(v) {
    return JSON.stringify(v)
      .replace(/</g, '\\u003c')
      .replace(/>/g, '\\u003e')
      .replace(/&/g, '\\u0026')
      .replace(/\u2028/g, '\\u2028')
      .replace(/\u2029/g, '\\u2029');
  }
  const whFetched = fetchedAt
    ? new Date(fetchedAt).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta', dateStyle: 'medium', timeStyle: 'short' })
    : '-';
  const whVolume = rows.reduce((s, r) => s + (Number(r.volume) || 0), 0);
  const whNilai = rows.reduce((s, r) => s + (Number(r.totalNilai) || 0), 0);
  const whTiket = new Set(rows.map(r => r.tiket).filter(Boolean)).size;
  const whPid = new Set(rows.map(r => r.pid).filter(Boolean)).size;
  const whBon = new Set(rows.map(r => r.gi).filter(Boolean)).size;
%>

<style>
  .wh-modal { position:fixed; inset:0; background:rgba(8,20,40,.48); display:none; align-items:center; justify-content:center; z-index:9999; padding:18px; }
  .wh-modal.show { display:flex; }
  .wh-modal-card { background:#fff; border-radius:12px; width:min(1180px,96vw); max-height:88vh; overflow:auto; box-shadow:0 20px 60px rgba(0,0,0,.25); }
  .wh-modal-head { position:sticky; top:0; background:#fff; border-bottom:1px solid var(--line); padding:14px 18px; display:flex; justify-content:space-between; align-items:flex-start; gap:12px; z-index:2; }
  .wh-modal-body { padding:14px 18px 20px; }
  .wh-chip { display:inline-flex; flex-direction:column; gap:2px; background:#F5F7FA; border:1px solid var(--line); border-radius:8px; padding:8px 14px; min-width:118px; }
  .wh-chip span { font-size:10px; letter-spacing:.06em; color:var(--ink-2); text-transform:uppercase; }
  .wh-chip b { font-size:16px; color:var(--navy); }
  .wh-clickable { cursor:pointer; }
  .wh-hint { font-size:11px; color:var(--ink-2); }
  .wh-toast { position:fixed; right:22px; bottom:22px; background:var(--navy); color:#fff; padding:10px 16px; border-radius:8px; font-size:13px; box-shadow:0 8px 24px rgba(0,0,0,.2); opacity:0; pointer-events:none; transition:opacity .2s; z-index:10000; }
  .wh-toast.show { opacity:1; }
  .wh-table th { white-space:nowrap; }
  .wh-table td { white-space:nowrap; }
  .wh-badge { display:inline-block; padding:3px 8px; border-radius:20px; background:#EAF1FF; color:var(--blue); font-size:10px; font-weight:700; letter-spacing:.03em; }
</style>

<main style="display:flex; flex-direction:column; gap:14px;">

  <div style="display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap;">
    <div>
      <h1 style="font-size:28px; font-weight:500; color:var(--ink); letter-spacing:-0.5px;">WAREHOUSE</h1>
      <p style="font-size:13px; color:var(--ink-2); margin-top:2px;">
        Rekon Freelance — Monitoring ID Reservasi &amp; Bon ODP di Warehouse.
        Sumber: sheet <b>MANUAL/GAMAS</b>, kolom B <b>KONSTRUKSI</b> saja.
      </p>
    </div>
    <div style="display:flex; align-items:center; gap:8px;">
      <span style="font-size:11px; color:var(--ink-2);" id="whFetched">Sumber data: <%= whFetched %></span>
      <button type="button" class="btn-pill" id="whRefresh" style="background:#FFFFFF;">
        <i class="fa-solid fa-rotate"></i> Refresh sheet
      </button>
      <button type="button" class="btn-pill btn-primary" id="whExport" style="height:30px; padding:0 16px;">
        <i class="fa-solid fa-download"></i> Export CSV
      </button>
    </div>
  </div>

  <% if (fetchError) { %>
    <div style="background:#FFF3F3; border:1px solid #F5C2C2; color:#8E2C2C; padding:10px 14px; border-radius:8px; font-size:12px;">
      <i class="fa-solid fa-triangle-exclamation"></i>
      Gagal mengambil sheet terbaru (<%= fetchError %>).
      <%= stale ? 'Menampilkan data tersimpan terakhir.' : 'Tabel masih kosong.' %>
    </div>
  <% } %>

  <!-- KPI -->
  <div class="kpi-row" style="grid-template-columns:repeat(5, 1fr);">
    <div class="kpi-card"><div class="kpi-label">TIKET</div><div class="kpi-num" id="kpiTiket"><%= whTiket %></div></div>
    <div class="kpi-card"><div class="kpi-label">PID</div><div class="kpi-num" id="kpiPid"><%= whPid %></div></div>
    <div class="kpi-card"><div class="kpi-label">BON / GI</div><div class="kpi-num" id="kpiBon" style="color:var(--accent);"><%= whBon %></div></div>
    <div class="kpi-card"><div class="kpi-label">VOLUME</div><div class="kpi-num" id="kpiVolume" style="color:var(--blue);"><%= whVolume.toLocaleString('id-ID') %></div></div>
    <div class="kpi-card"><div class="kpi-label">TOTAL NILAI</div><div class="kpi-num" id="kpiNilai" style="font-size:20px;">Rp<%= whNilai.toLocaleString('id-ID') %></div></div>
  </div>

  <!-- PIVOT -->
  <div class="card">
    <div class="card-head">
      <div class="card-head-left">
        <div class="card-icon-box"><i class="fa-solid fa-table-cells-large"></i></div>
        <h2 class="card-title" style="font-size:22px;">Pivot Warehouse</h2>
      </div>
      <div class="wh-hint">Klik baris pivot untuk melihat detail transaksi</div>
    </div>

    <div class="filter-bar">
      <input type="text" id="whSearch" class="filter-input" style="min-width:260px;" placeholder="Cari tiket, PID, bon, ID reservasi, barang…">
      <select id="whWh" class="filter-input" style="cursor:pointer;">
        <option value="">Semua WH</option>
        <% [...new Set(rows.map(r => r.namaWh).filter(Boolean))].sort().forEach(w => { %>
          <option value="<%= w %>"><%= w %></option>
        <% }); %>
      </select>
      <select id="whStatus" class="filter-input" style="cursor:pointer;">
        <option value="">Semua Status Transaksi</option>
        <% [...new Set(rows.map(r => r.statusTransaksi).filter(Boolean))].sort().forEach(s => { %>
          <option value="<%= s %>"><%= s %></option>
        <% }); %>
      </select>
      <button type="button" class="btn-pill" id="whReset" style="background:#FFFFFF; height:30px; padding:0 14px;">
        <i class="fa-solid fa-eraser"></i> Reset
      </button>
    </div>

    <div class="filter-bar" style="border-top:1px solid var(--line); padding-top:10px;">
      <span style="font-size:12px; color:var(--ink-2);">Kelompokkan:</span>
      <select id="whGroup" class="filter-input" style="cursor:pointer;">
        <option value="tiket">TIKET</option>
        <option value="pid">PID</option>
        <option value="gi">GI / BON</option>
        <option value="idResv">ID RESERVASI</option>
        <option value="namaWh">NAMA WH</option>
        <option value="idBarang">ID BARANG</option>
        <option value="statusTransaksi">STATUS TRANSAKSI</option>
      </select>
      <span style="font-size:12px; color:var(--ink-2);">Urutkan:</span>
      <select id="whMetric" class="filter-input" style="cursor:pointer;">
        <option value="volume">Volume</option>
        <option value="nilai">Total Nilai</option>
        <option value="baris">Jumlah Baris</option>
      </select>
      <select id="whSort" class="filter-input" style="cursor:pointer;">
        <option value="desc">Terbesar</option>
        <option value="asc">Terkecil</option>
      </select>
      <span id="whPivotInfo" class="wh-hint" style="margin-left:auto;"></span>
    </div>

    <div class="table-wrap">
      <table class="data-table wh-table" id="whPivotTable">
        <thead>
          <tr>
            <th id="whGroupHead">TIKET</th>
            <th style="text-align:right;">PID</th>
            <th style="text-align:right;">BON / GI</th>
            <th style="text-align:right;">ID RESV</th>
            <th style="text-align:right;">MATERIAL</th>
            <th style="text-align:right;">VOLUME</th>
            <th style="text-align:right;">TOTAL NILAI</th>
            <th style="width:90px; text-align:center;">DETAIL</th>
          </tr>
        </thead>
        <tbody id="whPivotBody"></tbody>
      </table>
    </div>
  </div>

  <!-- DATA PER BARIS -->
  <div class="card">
    <div class="card-head">
      <div class="card-head-left">
        <div class="card-icon-box"><i class="fa-solid fa-list"></i></div>
        <h2 class="card-title" style="font-size:22px;">Data Transaksi Konstruksi</h2>
      </div>
      <div style="font-size:12px; color:var(--ink-2);">Baris: <b id="whRowCount"><%= rows.length %></b></div>
    </div>
    <div class="table-wrap">
      <table class="data-table wh-table" id="whRawTable">
        <thead>
          <tr>
            <th style="width:35px;">No</th>
            <th>TIKET</th>
            <th>PID</th>
            <th>GI / BON</th>
            <th>ID RESERVASI</th>
            <th>NAMA WH</th>
            <th>ID BARANG</th>
            <th style="text-align:right;">VOLUME</th>
            <th>TANGGAL</th>
            <th>STATUS TRANSAKSI</th>
            <th style="text-align:right;">TOTAL NILAI</th>
          </tr>
        </thead>
        <tbody id="whRawBody"></tbody>
      </table>
    </div>
  </div>
</main>

<div class="wh-modal" id="whModal">
  <div class="wh-modal-card">
    <div class="wh-modal-head">
      <div>
        <div class="wh-hint" id="whModalLabel">DETAIL TRANSAKSI</div>
        <h3 id="whModalTitle" style="font-size:20px; font-weight:600; color:var(--navy); margin-top:2px; word-break:break-word;"></h3>
      </div>
      <button type="button" class="btn-circle" id="whModalClose" aria-label="Tutup detail" style="background:#F5F7FA;">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="wh-modal-body">
      <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px;">
        <div class="wh-chip"><span>Baris</span><b id="whDCount">0</b></div>
        <div class="wh-chip"><span>Bon / GI</span><b id="whDBon">0</b></div>
        <div class="wh-chip"><span>Volume</span><b id="whDVolume">0</b></div>
        <div class="wh-chip"><span>Total Nilai</span><b id="whDNilai">0</b></div>
      </div>
      <div class="table-wrap" style="max-height:52vh; overflow:auto;">
        <table class="data-table wh-table">
          <thead>
            <tr>
              <th>TIKET</th><th>PID</th><th>GI / BON</th><th>ID RESV</th><th>WH</th>
              <th>ID BARANG</th><th style="text-align:right;">VOLUME</th><th>KHS</th>
              <th>TANGGAL</th><th>STATUS</th><th style="text-align:right;">NILAI</th>
            </tr>
          </thead>
          <tbody id="whDetailBody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="wh-toast" id="whToast"></div>

<script>
  let WAREHOUSE_ROWS = <%- scriptJson(rows) %>;

  const GROUP_FIELDS = {
    tiket: { label: 'TIKET', get: r => r.tiket },
    pid: { label: 'PID', get: r => r.pid },
    gi: { label: 'GI / BON', get: r => r.gi },
    idResv: { label: 'ID RESERVASI', get: r => r.idResv },
    namaWh: { label: 'NAMA WH', get: r => r.namaWh },
    idBarang: { label: 'ID BARANG', get: r => r.idBarang },
    statusTransaksi: { label: 'STATUS TRANSAKSI', get: r => r.statusTransaksi }
  };

  const $ = (id) => document.getElementById(id);
  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));
  const num = (v) => Number(v) || 0;
  const fmt = (v) => num(v).toLocaleString('id-ID');
  const uniqCount = (list, key) => new Set(list.map(x => x[key]).filter(Boolean)).size;

  let lastPivot = [];

  function filteredRows() {
    const q = $('whSearch').value.trim().toLowerCase();
    const wh = $('whWh').value;
    const status = $('whStatus').value;
    return WAREHOUSE_ROWS.filter(r => {
      if (wh && String(r.namaWh || '') !== wh) return false;
      if (status && String(r.statusTransaksi || '') !== status) return false;
      if (!q) return true;
      return [r.tiket, r.pid, r.gi, r.idResv, r.idBarang, r.namaWh, r.lokasi, r.noRfc]
        .some(v => String(v || '').toLowerCase().includes(q));
    });
  }

  function buildPivot(rows) {
    const field = $('whGroup').value;
    const get = GROUP_FIELDS[field].get;
    const map = new Map();
    rows.forEach(r => {
      const key = String(get(r) || '').trim() || '(kosong)';
      if (!map.has(key)) map.set(key, { key, items: [] });
      map.get(key).items.push(r);
    });
    const groups = [...map.values()].map(g => ({
      key: g.key,
      items: g.items,
      volume: g.items.reduce((s, r) => s + num(r.volume), 0),
      nilai: g.items.reduce((s, r) => s + num(r.totalNilai), 0),
      tiketCount: uniqCount(g.items, 'tiket'),
      pidCount: uniqCount(g.items, 'pid'),
      bonCount: uniqCount(g.items, 'gi'),
      resvCount: uniqCount(g.items, 'idResv'),
      barangCount: uniqCount(g.items, 'idBarang')
    }));
    const metric = $('whMetric').value;
    const dir = $('whSort').value === 'asc' ? 1 : -1;
    const score = g => metric === 'volume' ? g.volume : metric === 'nilai' ? g.nilai : g.items.length;
    groups.sort((a, b) => (score(a) - score(b)) * dir || a.key.localeCompare(b.key));
    return groups;
  }

  function renderKpi(rows) {
    $('kpiTiket').textContent = fmt(uniqCount(rows, 'tiket'));
    $('kpiPid').textContent = fmt(uniqCount(rows, 'pid'));
    $('kpiBon').textContent = fmt(uniqCount(rows, 'gi'));
    $('kpiVolume').textContent = fmt(rows.reduce((s, r) => s + num(r.volume), 0));
    $('kpiNilai').textContent = 'Rp' + fmt(rows.reduce((s, r) => s + num(r.totalNilai), 0));
  }

  function renderPivot(groups) {
    $('whGroupHead').textContent = GROUP_FIELDS[$('whGroup').value].label;
    $('whPivotInfo').textContent = groups.length + ' kelompok / ' + lastPivot.reduce((s, g) => s + g.items.length, 0) + ' baris';
    $('whPivotBody').innerHTML = groups.map((g, i) => `
      <tr class="wh-clickable" data-pidx="${i}">
        <td><b>${esc(g.key)}</b></td>
        <td style="text-align:right;">${fmt(g.pidCount)}</td>
        <td style="text-align:right;">${fmt(g.bonCount)}</td>
        <td style="text-align:right;">${fmt(g.resvCount)}</td>
        <td style="text-align:right;">${fmt(g.barangCount)}</td>
        <td style="text-align:right;"><b>${fmt(g.volume)}</b></td>
        <td style="text-align:right;">Rp${fmt(g.nilai)}</td>
        <td style="text-align:center;"><span class="wh-badge"><i class="fa-solid fa-arrow-up-right-from-square"></i> LIHAT</span></td>
      </tr>`).join('') || '<tr><td colspan="8" style="text-align:center; color:var(--ink-2);">Tidak ada data</td></tr>';
  }

  function renderRaw(rows) {
    $('whRowCount').textContent = fmt(rows.length);
    $('whRawBody').innerHTML = rows.map(r => `
      <tr class="wh-clickable" data-no="${esc(r.no)}">
        <td>${fmt(r.no)}</td>
        <td>${esc(r.tiket)}</td>
        <td>${esc(r.pid)}</td>
        <td>${esc(r.gi)}</td>
        <td>${esc(r.idResv)}</td>
        <td>${esc(r.namaWh)}</td>
        <td>${esc(r.idBarang)}</td>
        <td style="text-align:right;">${fmt(r.volume)}</td>
        <td>${esc(r.tanggal)}</td>
        <td>${esc(r.statusTransaksi)}</td>
        <td style="text-align:right;">Rp${fmt(r.totalNilai)}</td>
      </tr>`).join('') || '<tr><td colspan="11" style="text-align:center; color:var(--ink-2);">Tidak ada data</td></tr>';
  }

  function renderAll() {
    const rows = filteredRows();
    renderKpi(rows);
    lastPivot = buildPivot(rows);
    renderPivot(lastPivot);
    renderRaw(rows);
  }

  function detailRows(items) {
    return items.map(r => `
      <tr>
        <td>${esc(r.tiket)}</td><td>${esc(r.pid)}</td><td>${esc(r.gi)}</td><td>${esc(r.idResv)}</td>
        <td>${esc(r.namaWh)}</td><td>${esc(r.idBarang)}</td>
        <td style="text-align:right;">${fmt(r.volume)}</td><td>${esc(r.khs)}</td>
        <td>${esc(r.tanggal)}</td><td>${esc(r.statusTransaksi)}</td>
        <td style="text-align:right;">Rp${fmt(r.totalNilai)}</td>
      </tr>`).join('');
  }

  function showModal(label, title, items) {
    $('whModalLabel').textContent = label;
    $('whModalTitle').textContent = title;
    $('whDCount').textContent = fmt(items.length);
    $('whDBon').textContent = fmt(uniqCount(items, 'gi'));
    $('whDVolume').textContent = fmt(items.reduce((s, r) => s + num(r.volume), 0));
    $('whDNilai').textContent = 'Rp' + fmt(items.reduce((s, r) => s + num(r.totalNilai), 0));
    $('whDetailBody').innerHTML = detailRows(items);
    $('whModal').classList.add('show');
  }

  function closeModal() { $('whModal').classList.remove('show'); }

  function toast(msg) {
    const el = $('whToast');
    el.textContent = msg;
    el.classList.add('show');
    setTimeout(() => el.classList.remove('show'), 2600);
  }

  function refreshOptions() {
    const whs = [...new Set(WAREHOUSE_ROWS.map(r => r.namaWh).filter(Boolean))].sort();
    const sts = [...new Set(WAREHOUSE_ROWS.map(r => r.statusTransaksi).filter(Boolean))].sort();
    const curWh = $('whWh').value, curSt = $('whStatus').value;
    $('whWh').innerHTML = '<option value="">Semua WH</option>' + whs.map(v => `<option value="${esc(v)}">${esc(v)}</option>`).join('');
    $('whStatus').innerHTML = '<option value="">Semua Status Transaksi</option>' + sts.map(v => `<option value="${esc(v)}">${esc(v)}</option>`).join('');
    if (whs.includes(curWh)) $('whWh').value = curWh;
    if (sts.includes(curSt)) $('whStatus').value = curSt;
  }

  function csvCell(v) {
    const s = String(v == null ? '' : v);
    return /[",\r\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  }

  function exportCsv() {
    const rows = filteredRows();
    const cols = [
      ['TIKET', r => r.tiket], ['KET', r => r.ket], ['PID', r => r.pid],
      ['GI/BON', r => r.gi], ['ID RESV', r => r.idResv], ['NAMA WH', r => r.namaWh],
      ['ID BARANG', r => r.idBarang], ['VOLUME', r => r.volume], ['TANGGAL', r => r.tanggal],
      ['STATUS TRANSAKSI', r => r.statusTransaksi], ['TOTAL NILAI', r => r.totalNilai]
    ];
    const lines = [cols.map(c => csvCell(c[0])).join(',')];
    rows.forEach(r => lines.push(cols.map(c => csvCell(c[1](r))).join(',')));
    const blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'WAREHOUSE_KONSTRUKSI_' + Date.now() + '.csv';
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    toast('CSV berhasil diunduh: ' + rows.length + ' baris');
  }

  async function refreshData() {
    const btn = $('whRefresh');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-rotate fa-spin"></i> Mengambil…';
    try {
      const res = await fetch('/warehouse/api/data?refresh=1');
      const j = await res.json();
      if (!j.ok) throw new Error(j.error || 'Gagal mengambil sheet');
      WAREHOUSE_ROWS = j.rows;
      refreshOptions();
      renderAll();
      $('whFetched').textContent = 'Sumber data: ' + new Date(j.fetchedAt).toLocaleString('id-ID');
      toast('Sheet berhasil diperbarui: ' + j.count + ' baris konstruksi');
    } catch (e) {
      toast('Gagal refresh: ' + e.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-rotate"></i> Refresh sheet';
    }
  }

  ['whSearch', 'whWh', 'whStatus', 'whGroup', 'whMetric', 'whSort'].forEach(id => {
    $(id).addEventListener(id === 'whSearch' ? 'input' : 'change', renderAll);
  });
  $('whReset').addEventListener('click', () => {
    $('whSearch').value = '';
    $('whWh').value = '';
    $('whStatus').value = '';
    renderAll();
  });
  $('whExport').addEventListener('click', exportCsv);
  $('whRefresh').addEventListener('click', refreshData);
  $('whPivotBody').addEventListener('click', (e) => {
    const tr = e.target.closest('tr[data-pidx]');
    if (!tr) return;
    const g = lastPivot[Number(tr.dataset.pidx)];
    showModal(GROUP_FIELDS[$('whGroup').value].label, g.key, g.items);
  });
  $('whRawBody').addEventListener('click', (e) => {
    const tr = e.target.closest('tr[data-no]');
    if (!tr) return;
    const r = WAREHOUSE_ROWS.find(x => String(x.no) === String(tr.dataset.no));
    if (r) showModal('DETAIL TRANSAKSI', r.tiket, [r]);
  });
  $('whModalClose').addEventListener('click', closeModal);
  $('whModal').addEventListener('click', (e) => { if (e.target === $('whModal')) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  renderAll();
</script>

<%- include('partials/footer') %>
